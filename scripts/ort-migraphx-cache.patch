+// The shared provider API omits nested protobuf tensor accessors. These field
+// numbers come from ONNX's Model/Graph/Node/Attribute/Tensor/SparseTensor schema.
+// A malformed or unknown wire encoding disables persistent caching.
+enum class CacheProto { Model, Graph, Node, Attribute, Tensor, SparseTensor, Function, Training };
+
+bool cache_read_varint(std::string_view& data, uint64_t& value) {
+  value = 0;
+  for (int shift = 0; shift < 64 && !data.empty(); shift += 7) {
+    uint8_t byte = static_cast<uint8_t>(data.front());
+    data.remove_prefix(1);
+    if (shift == 63 && byte > 1) return false;
+    value |= static_cast<uint64_t>(byte & 127) << shift;
+    if (!(byte & 128)) return true;
+  }
+  return false;
 }

