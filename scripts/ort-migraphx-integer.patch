+static Status RewriteMatMulIntegerNodes(Graph& graph) {
+  // Model::Create builds this graph from the filtered ONNX proto. Resolve it
+  // before inspecting NodeArg types and shapes, which may not be populated yet.
+  auto resolve_status = graph.Resolve();
+  if (!resolve_status.IsOK()) return resolve_status;
+
+  std::vector<NodeIndex> matmul_integer_nodes;
+  for (const Node* node : graph.Nodes()) {
+    if (node->OpType() == "MatMulInteger" && node->Domain() == kOnnxDomain) {
+      matmul_integer_nodes.push_back(node->Index());
+    }
+  }
+  if (matmul_integer_nodes.empty()) return graph.Resolve();
+
+  const auto& domain_versions = graph.DomainToVersionMap();
+  const auto opset_it = domain_versions.find(kOnnxDomain);
+  const int opset = opset_it == domain_versions.end() ? 0 : opset_it->second;
+  if (opset <= 0) {
+    return Status(common::ONNXRUNTIME, common::EP_FAIL,
+                  "MIGraphX cannot rewrite MatMulInteger nodes: the model has no default ONNX opset version");
+  }
+  for (NodeIndex index : matmul_integer_nodes) {
+    const Node* node = graph.GetNode(index);
+    if (node == nullptr) {
+      return Status(common::ONNXRUNTIME, common::EP_FAIL,
+                    MakeString("MIGraphX cannot rewrite MatMulInteger node at missing graph index ", index));
+    }
+    auto status = RewriteMatMulIntegerNode(graph, *node, opset);
+    if (!status.IsOK()) return status;
+  }
+  return graph.Resolve();
+}
+
+static bool ContainsMatMulInteger(const Graph& graph);
+
+static bool ContainsMatMulInteger(const Node& node) {
+  if (node.Domain() == kOnnxDomain && node.OpType() == "MatMulInteger") return true;
+  for (const auto& subgraph : node.GetSubgraphs()) {
+    if (ContainsMatMulInteger(*subgraph)) return true;
+  }
+  return false;
+}
+
+static bool ContainsMatMulInteger(const Graph& graph) {
+  for (const Node* node : graph.Nodes()) {
+    if (ContainsMatMulInteger(*node)) return true;
+  }
+  return false;
+}
