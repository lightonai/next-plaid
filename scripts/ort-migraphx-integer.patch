+  builder.AddNode("Mul", {c_a_broadcast, &sum_b}, term_a);
+  auto term_b_type = MakeBroadcastTensorType(sum_a, *c_b_broadcast);
+  auto& term_b = builder.MakeArg("b_zero_point_term", term_b_type.get());
+  builder.AddNode("Mul", {&sum_a, c_b_broadcast}, term_b);
+  auto cross_type = MakeBroadcastTensorType(*c_a_broadcast, *c_b_broadcast);
+  auto& cross_zero_points = builder.MakeArg("cross_zero_points", cross_type.get());
+  builder.AddNode("Mul", {c_a_broadcast, c_b_broadcast}, cross_zero_points);
+  auto& reduction_length = AddDynamicReductionLength(builder, a_arg, a_rank - 1, "reduction");
+  auto& cross_term = builder.MakeArg("cross_term", cross_type.get());
+  builder.AddNode("Mul", {&cross_zero_points, &reduction_length}, cross_term);
+
+  auto& partial_result = builder.MakeArg("partial_result", int32_output_type.get());
+  builder.AddNode("Add", {&raw_result, &term_a}, partial_result);
+  auto& partial_result2 = builder.MakeArg("partial_result_2", int32_output_type.get());
+  builder.AddNode("Add", {&partial_result, &term_b}, partial_result2);
+  builder.AddNode("Add", {&partial_result2, &cross_term}, y_arg);
+  return Status::OK();
+}
