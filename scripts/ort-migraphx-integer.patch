+  builder.AddNode("Cast", {&a_centered}, a32, a32_cast_attributes.get());
+  auto b32_type = CopyTensorType(b_centered.TypeAsProto(), ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_INT32);
+  auto& b32 = builder.MakeArg("b_int32", b32_type.get());
+  auto b32_cast_attributes = builder.MakeIntAttribute("to", ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_INT32);
+  builder.AddNode("Cast", {&b_centered}, b32, b32_cast_attributes.get());
