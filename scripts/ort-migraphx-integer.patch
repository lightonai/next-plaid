+static Status RewriteMatMulIntegerNode(Graph& graph, const Node& original_node, int opset) {
+  const auto unsupported_reason = MatMulIntegerRewriteUnsupportedReason(original_node);
+  if (!unsupported_reason.empty()) {
+    return Status(common::ONNXRUNTIME, common::EP_FAIL,
+                  MakeString("MIGraphX cannot rewrite MatMulInteger node '", original_node.Name(), "' (",
+                             original_node.Index(), "): ", unsupported_reason));
+  }
+  const auto& original_inputs = original_node.InputDefs();
+  const auto& original_output = *original_node.OutputDefs()[0];
+  const std::string node_prefix = "migraphx_integer_" + std::to_string(original_node.Index());
+  const std::string a_name = original_inputs[0]->Name();
+  const std::string b_name = original_inputs[1]->Name();
+  const std::string a_zero_point_name = original_inputs.size() > 2 ? original_inputs[2]->Name() : std::string{};
+  const std::string b_zero_point_name = original_inputs.size() > 3 ? original_inputs[3]->Name() : std::string{};
+  const std::string output_name = original_output.Name();
+  auto a_type = CopyTensorType(original_inputs[0]->TypeAsProto(), original_inputs[0]->TypeAsProto()->tensor_type().elem_type());
+  auto b_type = CopyTensorType(original_inputs[1]->TypeAsProto(), original_inputs[1]->TypeAsProto()->tensor_type().elem_type());
+  auto y_type = CopyTensorType(original_output.TypeAsProto(), original_output.TypeAsProto()->tensor_type().elem_type());
+  std::unique_ptr<ONNX_NAMESPACE::TypeProto> a_zp_type;
+  std::unique_ptr<ONNX_NAMESPACE::TypeProto> b_zp_type;
+  if (!a_zero_point_name.empty()) a_zp_type = CopyTensorType(original_inputs[2]->TypeAsProto(), original_inputs[2]->TypeAsProto()->tensor_type().elem_type());
+  if (!b_zero_point_name.empty()) b_zp_type = CopyTensorType(original_inputs[3]->TypeAsProto(), original_inputs[3]->TypeAsProto()->tensor_type().elem_type());
+  const int a_rank = original_inputs[0]->Shape()->dim_size();
+  const int b_rank = original_inputs[1]->Shape()->dim_size();
+  const int a_offset = a_type->tensor_type().elem_type() == ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_UINT8 ? 128 : 0;
+  const int b_offset = b_type->tensor_type().elem_type() == ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_UINT8 ? 128 : 0;
+
+  struct EdgeToRemove final {
+    NodeIndex destination;
+    int source_arg;
+    int destination_arg;
+  };
+  std::vector<EdgeToRemove> output_edges;
+  for (auto edge_it = original_node.OutputEdgesBegin(); edge_it != original_node.OutputEdgesEnd(); ++edge_it) {
+    const auto& edge = *edge_it;
+    output_edges.push_back({edge.GetNode().Index(), edge.GetSrcArgIndex(), edge.GetDstArgIndex()});
+  }
+  for (const auto& edge : output_edges) {
+    graph.RemoveEdge(original_node.Index(), edge.destination, edge.source_arg, edge.destination_arg);
+  }
