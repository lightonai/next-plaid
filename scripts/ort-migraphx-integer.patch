+static bool IsInteger8DataType(int32_t element_type) {
+  return element_type == ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_INT8 ||
+         element_type == ONNX_NAMESPACE::TensorProto_DataType::TensorProto_DataType_UINT8;
+}
+
+static bool IsDimensionCompatible(const ONNX_NAMESPACE::TensorShapeProto_Dimension& actual,
+                                  const ONNX_NAMESPACE::TensorShapeProto_Dimension& expected) {
+  if (actual.has_dim_value() && expected.has_dim_value()) {
+    return actual.dim_value() == expected.dim_value();
+  }
+  if (actual.has_dim_param() && expected.has_dim_param()) {
+    return actual.dim_param() == expected.dim_param();
+  }
+  return true;
+}
